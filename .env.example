# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place actual secrets or passwords in this template.
# Copy to .env or .env.local for local overrides.
# ==============================================================================

# Application Environment
NODE_ENV=production
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_NAME="HOJEONG – Hệ thống chấm công và tính lương"
EXPO_PUBLIC_APP_VERSION=0.1.0

# ==============================================================================
# SUPABASE CLOUD CONFIGURATION
# Obtain these from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
# ==============================================================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "jsx": "react",
    "types": ["jest", "node"],
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "build"
  },
  "exclude": [
    "node_modules",
    "build"
  ],
  "extends": "expo/tsconfig.base"
}

{
  "name": "cham-cong-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('web-build', { recursive: true, force: true });\"",
    "build": "node -e \"const fs = require('fs'); fs.rmSync('web-build', { recursive: true, force: true });\" && expo export:web && node scripts/postbuild.js",
    "build:web": "node -e \"const fs = require('fs'); fs.rmSync('web-build', { recursive: true, force: true });\" && expo export:web && node scripts/postbuild.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "expo": "~48.0.0",
    "react": "18.2.0",
    "react-native": "0.71.14",
    "expo-sqlite": "~11.1.0",
    "zustand": "^4.3.8",
    "typescript": "^4.9.4",
    "@types/react": "~18.0.27",
    "react-native-web": "~0.18.10",
    "react-dom": "18.2.0",
    "@expo/webpack-config": "^18.0.1"
  },
  "devDependencies": {
    "typescript": "^5.0.4",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.5",
    "react-test-renderer": "18.2.0",
    "@testing-library/react-native": "12.1.2",
    "jest-expo": "~48.0.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.71.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "homepage": "https://xuantri050605.github.io/hj.chomcong.app"
}